{
  "title": "Translator",
  "uid": "translator",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "Requests per second",
     "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{status}}",
                  "expr": "sum by (status) (rate(translate_requests_total[1m]))"}]},
    {"id": 2, "type": "timeseries", "title": "p95 latency (seconds)",
     "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A",
                  "expr": "histogram_quantile(0.95, sum by (le) (rate(translate_latency_seconds_bucket[5m])))"}]},
    {"id": 3, "type": "stat", "title": "Cache hit ratio",
     "gridPos": {"x": 0, "y": 8, "w": 6, "h": 6},
     "fieldConfig": {"defaults": {"unit": "percentunit"}},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A",
                  "expr": "sum(rate(translate_cache_hits_total[5m])) / sum(rate(translate_requests_total[5m]))"}]},
    {"id": 4, "type": "timeseries", "title": "LLM tokens per second",
     "gridPos": {"x": 6, "y": 8, "w": 18, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "legendFormat": "{{type}}",
                  "expr": "sum by (type) (rate(llm_tokens_total[1m]))"}]},
    {"id": 5, "type": "logs", "title": "App logs",
     "gridPos": {"x": 0, "y": 14, "w": 24, "h": 10},
     "datasource": {"type": "loki", "uid": "loki"},
     "targets": [{"refId": "A", "expr": "{service=\"app\"}"}]}
  ]
}
